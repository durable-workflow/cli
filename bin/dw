#!/usr/bin/env php
<?php

declare(strict_types=1);

// Re-execute a managed child in its own POSIX session before loading the CLI.
if (getenv('DW_CLI_EXEC_CHILD') === '1') {
    putenv('DW_CLI_EXEC_CHILD');
    unset($_ENV['DW_CLI_EXEC_CHILD'], $_SERVER['DW_CLI_EXEC_CHILD']);
    if (!function_exists('posix_setsid') || !function_exists('pcntl_exec') || posix_setsid() === -1) {
        fwrite(STDERR, "Cannot create the development child process session.\n");
        exit(1);
    }
    $child = array_slice($_SERVER['argv'], 1);
    pcntl_exec(array_shift($child), $child);
    fwrite(STDERR, "Cannot execute the development child process.\n");
    exit(1);
}

if (file_exists(__DIR__.'/../vendor/autoload.php')) {
    require __DIR__.'/../vendor/autoload.php';
} elseif (file_exists(__DIR__.'/../../../autoload.php')) {
    require __DIR__.'/../../../autoload.php';
}

use DurableWorkflow\Cli\Application;

$app = new Application();
$app->run();
